# The backend does not load .env files — python-dotenv is a data/collect dependency
# only. Export these as real environment variables, or set them as deploy secrets.

# Which database the API reads. One of:
#   file     stdlib sqlite3 against a local path (default) — dev, tests, CI
#   replica  embedded libSQL replica, synced from Turso    — production
#   remote   libSQL over HTTP straight to Turso            — smoke-testing the hosted copy
# DISHIT_DB_MODE=file

# --- file mode ---------------------------------------------------------------
# Absolute or repository-relative path to the canonical SQLite database used by
# data/db/load_db.py and enriched in place by data/calculate/calculate.py.
# Leave unset to use data/db/dishit.db.
# DISHIT_DATABASE=data/db/dishit.db

# --- replica and remote modes ------------------------------------------------
# From `turso db show dishit --url` and `turso db tokens create dishit`.
# TURSO_DATABASE_URL=libsql://dishit-<org>.turso.io
# TURSO_AUTH_TOKEN=

# replica mode only: local file backing the replica, and how often it pulls from
# Turso. The file is a cache, not state — deleting it costs one resync at boot.
# DISHIT_REPLICA_PATH=data/db/replica.db
# DISHIT_SYNC_INTERVAL=60

# Driver note (verified against libsql 0.1.11): the libSQL driver returns rows as
# plain tuples and has no row_factory, unlike sqlite3.Row. backend/app/db.py's
# Database.rows/.one build dicts from cursor.description so endpoint code indexes
# rows by column name identically in all three modes.
